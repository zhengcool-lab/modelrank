# =============================================================================
# ModelRank production environment.
# Copy to `.env` next to deploy/docker-compose.yml and fill in every secret.
#   cp deploy/.env.production.example .env
# DO NOT commit the real .env — it is gitignored.
# =============================================================================

# ---- Runtime ----
NODE_ENV=production
APP_ENV=production
LOG_LEVEL=info

# ---- Public URLs (browser-visible) ----
# What end users type in the browser. Must match the ICP-filed domain.
APP_BASE_URL=https://modelrank.example.com
# Path the web app calls from the browser; nginx routes /api/ to the api container.
NEXT_PUBLIC_API_BASE_URL=/api

# ---- Postgres (container-internal; the compose file builds DATABASE_URL for you) ----
POSTGRES_USER=modelrank
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=modelrank
# If you run Postgres outside the stack, override the built-in URL:
# DATABASE_URL=postgresql://modelrank:password@db.example.com:5432/modelrank

# ---- Redis ----
REDIS_URL=redis://redis:6379

# ---- Secrets ----
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me
SESSION_SECRET=change-me

# ---- Object storage (model artifacts / eval reports) ----
# Aliyun OSS as the default; swap to SCOS/COS if you deploy to Tencent Cloud.
OSS_REGION=oss-cn-beijing
OSS_BUCKET=modelrank-assets
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_CDN_BASE=https://your-bucket.oss-cn-beijing.aliyuncs.com

# ---- Upstream LLM provider keys (used by the eval worker) ----
# Leave blank to disable a provider.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
