# syntax=docker/dockerfile:1

# ---------- base ----------
FROM node:20-alpine AS base
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app

# ---------- deps ----------
FROM base AS deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json turbo.json ./
COPY apps/web/package.json ./apps/web/
COPY apps/api/package.json ./apps/api/
COPY packages/shared/package.json ./packages/shared/
RUN pnpm install --frozen-lockfile

# ---------- builder: emit NestJS dist/ ----------
FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/web/node_modules ./apps/web/node_modules
COPY --from=deps /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=deps /app/packages/shared/node_modules ./packages/shared/node_modules
COPY . .
RUN pnpm --filter @modelrank/api build

# ---------- runner: production deps + dist ----------
FROM base AS runner
ENV NODE_ENV=production
# Install only production workspace deps (no web, no dev tooling).
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/api/package.json ./apps/api/
COPY packages/shared/package.json ./packages/shared/
RUN pnpm install --frozen-lockfile --prod --filter @modelrank/api...
# Drop build tooling and lockfile from the runtime image.
RUN rm -f pnpm-lock.yaml
COPY --from=builder /app/apps/api/dist ./apps/api/dist
# shared is type-only today, but keep its source importable if needed at runtime.
COPY --from=builder /app/packages/shared ./packages/shared

WORKDIR /app/apps/api
EXPOSE 3001
ENV API_PORT=3001
CMD ["node", "dist/main.js"]
